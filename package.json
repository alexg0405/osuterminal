{
  "name": "osuterminal",
  "version": "1.1.4",
  "type": "module",
  "description": "unofficial osu!standard client for the terminal",
  "license": "MIT",
  "author": "Alexa Guo",
  "bin": {
    "osuterminal": "src/main.mjs"
  },
  "files": [
    "src",
    "tools/calibrate.mjs",
    "bundled",
    "README.md",
    "LEGAL.md",
    "LICENSE"
  ],
  "allowScripts": {
    "koffi": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexg0405/osuterminal.git"
  },
  "homepage": "https://github.com/alexg0405/osuterminal#readme",
  "bugs": {
    "url": "https://github.com/alexg0405/osuterminal/issues"
  },
  "keywords": [
    "osu",
    "osu!",
    "terminal",
    "rhythm",
    "cli",
    "game"
  ],
  "scripts": {
    "play": "node src/main.mjs",
    "probe": "node tools/probe.mjs",
    "test": "node tools/smoke.mjs",
    "test:parse": "node tools/parse-test.mjs",
    "test:audio": "node tools/audio-spike.mjs",
    "calibrate": "node tools/calibrate.mjs",
    "test:slider": "node tools/slider-test.mjs",
    "bench": "node tools/render-bench.mjs",
    "test:origin": "node tools/origin-test.mjs",
    "test:library": "node tools/library-test.mjs",
    "test:decode": "node tools/decode-test.mjs",
    "test:result": "node tools/result-test.mjs",
    "test:stack": "node tools/stack-test.mjs",
    "test:hitcircle": "node tools/hitcircle-test.mjs",
    "test:browse": "node tools/browse-test.mjs",
    "test:playfield": "node tools/playfield-test.mjs",
    "test:volume": "node tools/volume-test.mjs",
    "test:background": "node tools/background-test.mjs",
    "test:mods": "node tools/mods-test.mjs",
    "test:install": "node tools/install-test.mjs",
    "test:input": "node tools/input-vt-test.mjs",
    "test:hud": "node tools/hud-test.mjs",
    "test:aim": "node tools/aim-test.mjs",
    "test:arrow": "node tools/arrow-test.mjs",
    "test:followpoint": "node tools/followpoint-test.mjs",
    "test:sliderbody": "node tools/sliderbody-test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "jpeg-js": "^0.4.4",
    "koffi": "^3.1.6",
    "mpg123-decoder": "^1.0.3",
    "pngjs": "^7.0.0"
  }
}
